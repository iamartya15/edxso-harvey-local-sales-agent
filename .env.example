# ============================================================
# EDXSO fork — local-only environment variables
# Copy this file to .env:  cp .env.example .env
# Never commit .env — it is gitignored.
#
# This fork uses NO paid LLM API, NO subscription CLI, and NO paid
# third-party service. The only settings here point at a local Ollama
# server. The upstream .env.example (Gmail/SMTP, Instantly, Reoon,
# ZeroBounce, Hunter, DataForSEO, Serper, Scavio, Cloudflare, TrulyInbox,
# Precleared) is intentionally NOT shipped: those services are gated off
# in this fork. Email sending is disabled by default in the demo config;
# sample addresses are unverified guesses and are never sent to.
# ============================================================

# Ollama — local inference server (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Local model. qwen3:0.6b fits <8 GB RAM; qwen3:1.7b for 8-16 GB;
# qwen3:4b for 16 GB+ or a GPU. See scripts/hardware_check.py.
OLLAMA_MODEL=qwen3:0.6b

# Where the app keeps its state (default: this checkout's data/ folder).
# SELLBIRD_HOME=
